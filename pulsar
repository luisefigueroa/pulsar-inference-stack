#!/usr/bin/env bash
# Thin operator dispatcher; each selected command performs one explicit action.
set -euo pipefail
REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export PYTHONDONTWRITEBYTECODE=1
command="${1:-}"
[ $# -eq 0 ] || shift
case "$command" in
  start|stop|status|model)
    exec python3 "$REPO_DIR/scripts/public_cli.py" "$command" "$@"
    ;;
  observe|resources|policy|evidence|privacy|selftest|contribution|memory)
    exec python3 "$REPO_DIR/scripts/public_cli.py" "$command" "$@"
    ;;
esac
case "$command" in
  ""|gum) exec "$REPO_DIR/scripts/home.sh" ;;
  wizard) exec "$REPO_DIR/wizard.sh" "$@" ;;
  models) exec "$REPO_DIR/scripts/model-storage.sh" "$@" ;;
  inventory) exec "$REPO_DIR/scripts/inventory.sh" "$@" ;;
  doctor) exec "$REPO_DIR/scripts/doctor.sh" "$@" ;;
  contract) exec python3 "$REPO_DIR/scripts/integration_contract.py" "$@" ;;
  spec) exec python3 "$REPO_DIR/scripts/document_cli.py" "$@" ;;
  release) exec "$REPO_DIR/scripts/release.sh" "$@" ;;
  topology) exec "$REPO_DIR/scripts/topology.sh" "$@" ;;
  ssh-trust) exec "$REPO_DIR/scripts/topology-ssh-trust.sh" "$@" ;;
  configure)
    topic="${1:-}"; [ $# -eq 0 ] || shift
    case "$topic" in
      archive-root) exec "$REPO_DIR/scripts/configure-archive-root.sh" "$@" ;;
      *) echo 'usage: pulsar configure archive-root [show|set|disable]' >&2; exit 2 ;;
    esac ;;
  help|-h|--help)
    PYTHONPATH="$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
from scripts.terminal_format import TerminalWriter
w=TerminalWriter()
w.emit('Pulsar Inference Stack')
w.emit('Catalog, model storage, recovery and exact-spec serving.')
w.blank()
for command,description in [
 ('pulsar','Open the workflow menu; bind this checkout to the cluster before catalog actions.'),
 ('pulsar models','Browse catalog and saved storage observations.'),
 ('pulsar models show SPEC','Show recipe, known copies, pins and blockers.'),
 ('pulsar models check SPEC','Explicitly check the selected managed files and archive.'),
 ('pulsar model --help','Acquire, restore, move, prepare, pin, purge and archive.'),
 ('pulsar start SPEC','Recheck prerequisites and start the exact selected spec.'),
 ('pulsar stop SPEC','Stop the owned service; retain model files and pins.'),
 ('pulsar status SPEC','Observe the live service on all participating nodes.'),
 ('pulsar release list','Read catalog specs; deprecated human alias retained through CLI contract 1.'),
 ('pulsar inventory','Inspect service ownership and current resource use.'),
 ('pulsar doctor','Run explicit host and topology diagnostics.'),
 ('pulsar contract','Show the versioned stack/workbench integration contract.'),
 ('pulsar spec example|freeze|verify|compare','Author and inspect a complete JSON serving recipe.'),
 ('pulsar memory verify --file FILE --spec-file SPEC','Validate an explicit estimate of resident weights for the exact spec.'),
 ('pulsar observe --service-id ID [--full] [--verification-jobs N] --json','Verify every rank; reuse file verification unless --full requests hashing.'),
 ('pulsar resources --spec-file FILE --jsonl','Sample confirmed nodes before launch; wait for the matching owned container.'),
 ('pulsar gum','Open the interactive Gum/plain workflow menu.'),
 ('pulsar topology setup','First-use membership and SSH enrollment with separate confirmations.'),
 ('pulsar topology show|check|detect|configure','Inspect saved membership, check nodes, discover or explicitly configure.'),
 ('pulsar ssh-trust --help','Inspect or explicitly enroll SSH trust.'),
 ('pulsar configure archive-root','Select an existing recovery directory.')]:
    w.emit(command)
    w.emit(description,initial_indent='  ')
w.blank()
w.emit('SPEC is the complete catalog spec ID. Candidate files are accepted only through explicit --spec-file. Review status, prepared files and a running service are separate. See docs/OPERATIONS.md.')
PY
    ;;
  *) printf 'Unknown command: %s\nTry: ./pulsar help\n' "$command" >&2; exit 2 ;;
esac
