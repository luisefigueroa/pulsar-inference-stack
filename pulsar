#!/usr/bin/env bash
# Thin operator dispatcher; each selected command performs one explicit action.
set -euo pipefail
REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export PYTHONDONTWRITEBYTECODE=1
# A busy model-library lock names the operator command holding it by these;
# every process this command starts inherits them.
export PULSAR_COMMAND_LINE="pulsar${*:+ $*}" PULSAR_COMMAND_PID=$$
# Deprecated aliases warn once on stderr; `pulsar contract --json` lists them
# as deprecated_commands. They are removed in CLI contract 2.
deprecated() {
  printf 'warning: pulsar %s is deprecated; use %s. It is removed in CLI contract 2.\n' "$1" "$2" >&2
}
# refuse_json_for_menu MENU HINT ARGS... — a menu is interactive; --json asks
# for a command's JSON output instead.
refuse_json_for_menu() {
  local menu="$1" hint="$2" arg
  shift 2
  for arg in "$@"; do
    if [ "$arg" = --json ]; then
      printf 'error: %s is interactive; use %s\n' "$menu" "$hint" >&2
      exit 2
    fi
  done
}
command="${1:-}"
[ $# -eq 0 ] || shift
case "$command" in
  start|stop|status|model|models)
    # Human mode accepts a unique shortened catalog spec ID and prints the
    # complete ID it selected. --json and --spec-file keep the exact contract.
    selection=$(python3 "$REPO_DIR/scripts/spec_selector.py" --repo-root "$REPO_DIR" "$command" "$@") || exit $?
    if [ -n "$selection" ]; then
      arguments=("$@")
      arguments[${selection%% *}]="${selection#* }"
      set -- "${arguments[@]}"
    fi
    ;;
esac
case "$command" in
  start|stop|status|model)
    exec python3 "$REPO_DIR/scripts/public_cli.py" "$command" "$@"
    ;;
  observe|resources|policy|evidence|privacy|selftest|contribution|memory|guarded|image)
    exec python3 "$REPO_DIR/scripts/public_cli.py" "$command" "$@"
    ;;
esac
case "$command" in
  "") exec "$REPO_DIR/scripts/home.sh" ;;
  gum)
    deprecated gum pulsar
    refuse_json_for_menu "the Pulsar menu" "./pulsar help" "$@"
    exec "$REPO_DIR/scripts/home.sh" ;;
  wizard)
    deprecated wizard "pulsar models"
    # Like pulsar models: the menu on a terminal, otherwise the catalog list.
    if [ -t 0 ]; then
      refuse_json_for_menu "the catalog menu" "./pulsar models list --json" "$@"
      exec "$REPO_DIR/wizard.sh" "$@"
    fi
    exec "$REPO_DIR/scripts/model-storage.sh" list "$@" ;;
  models) exec "$REPO_DIR/scripts/model-storage.sh" "$@" ;;
  inventory) exec "$REPO_DIR/scripts/inventory.sh" "$@" ;;
  doctor) exec "$REPO_DIR/scripts/doctor.sh" "$@" ;;
  contract) exec python3 "$REPO_DIR/scripts/integration_contract.py" "$@" ;;
  spec) exec python3 "$REPO_DIR/scripts/document_cli.py" "$@" ;;
  release)
    for arg in "$@"; do
      if [ "$arg" = list ]; then deprecated "release list" "pulsar models list"; break; fi
    done
    exec "$REPO_DIR/scripts/release.sh" "$@" ;;
  topology) exec "$REPO_DIR/scripts/topology.sh" "$@" ;;
  ssh-trust) exec "$REPO_DIR/scripts/topology-ssh-trust.sh" "$@" ;;
  configure)
    topic="${1:-}"; [ $# -eq 0 ] || shift
    case "$topic" in
      archive-root) exec "$REPO_DIR/scripts/configure-archive-root.sh" "$@" ;;
      *) echo 'usage: pulsar configure archive-root [show|set|disable]' >&2; exit 2 ;;
    esac ;;
  help|-h|--help)
    PYTHONPATH="$REPO_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
from scripts.terminal_format import TerminalWriter
w=TerminalWriter()
w.emit('Pulsar Inference Stack')
w.emit('Catalog, model storage, recovery and exact-spec serving.')
for heading,rows in [
 ('Set up this checkout',[
  ('pulsar','Open the menu on a terminal with Gum: setup steps and read-only browsing until this checkout is bound, then catalog and cluster actions.'),
  ('pulsar topology setup','First-use membership and SSH enrollment with separate confirmations.'),
  ('pulsar topology show|check|detect|configure','Inspect saved membership, check nodes, discover or explicitly configure.'),
  ('pulsar ssh-trust --help','Inspect or explicitly enroll SSH trust.'),
  ('pulsar configure archive-root','Select an existing archive location.'),
  ('pulsar doctor','Run explicit host and topology diagnostics.')]),
 ('Catalog and model files',[
  ('pulsar models','Browse catalog and saved storage observations.'),
  ('pulsar models show SPEC','Show recipe, known copies, pins and blockers.'),
  ('pulsar models check SPEC','Explicitly check the selected managed files and archive.'),
  ('pulsar model --help','Acquire, restore, move, prepare, pin, purge and archive.')]),
 ('Serve',[
  ('pulsar image check|stage SPEC','Inspect or explicitly stage the exact image on selected serving ranks.'),
  ('pulsar start SPEC','Recheck prerequisites and start the exact selected spec.'),
  ('pulsar guarded template|validate|run|stop|reconcile','Own a bounded trial and reconcile its completed locator.'),
  ('pulsar status SPEC','Observe the live service on all participating nodes.'),
  ('pulsar stop SPEC','Stop the owned service; retain model files and pins.'),
  ('pulsar inventory','Inspect service ownership and current resource use.')]),
 ('Contributors and integrations',[
  ('pulsar contract','Show the versioned stack/workbench integration contract.'),
  ('pulsar spec example|freeze|verify|compare','Author and inspect a complete JSON serving spec.'),
  ('pulsar memory verify --file FILE --spec-file FILE','Validate an explicit estimate of resident weights for the exact spec.'),
  ('pulsar observe --service-id ID [--full] [--verification-jobs N] --json','Verify every rank; reuse file verification unless --full requests hashing.'),
  ('pulsar resources --service-id ID|--spec-file FILE --jsonl','Sample confirmed nodes before launch; wait for the matching owned container.'),
  ('pulsar release list','Deprecated; use pulsar models list. Removed in CLI contract 2.')]),
]:
    w.blank()
    w.emit(heading)
    for command,description in rows:
        w.emit(command,initial_indent='  ')
        w.emit(description,initial_indent='    ')
w.blank()
w.emit('SPEC is a catalog spec ID. People may type a unique prefix of at least 12 characters; the command prints the complete ID it selected. --json, --spec-file, model purge and model remove require the complete 64-character ID. Candidate files are accepted only through explicit --spec-file. Review status, prepared files and a running service are separate. Most commands accept --help. See docs/OPERATIONS.md.')
PY
    ;;
  *)
    # Under --json an unknown command gets the same envelope as any other mistake.
    for arg in "$command" "$@"; do
      [ "$arg" != --json ] || exec python3 "$REPO_DIR/scripts/public_cli.py" "$command" "$@"
    done
    printf 'Unknown command: %s\nTry: ./pulsar help\n' "$command" >&2; exit 2 ;;
esac
